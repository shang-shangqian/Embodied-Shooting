<?xml version="1.0"?>
<robot name="turret">

  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.09 0.03"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.09 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Yaw link -->
  <link name="yaw_link">
    <inertial>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.03"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Pitch link -->
  <link name="pitch_link">
    <inertial>
      <origin xyz="0.045 0.0 0.0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <!-- a simple barrel -->
      <origin xyz="0.045 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.015 0.015"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.045 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.015 0.015"/>
      </geometry>
    </collision>
  </link>

  <!-- gun tip frame -->
  <link name="gun_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.003"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.003"/>
      </geometry>
    </collision>
  </link>

  <!-- yaw joint: base -> yaw_link (rotate around Z) -->
  <joint name="yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="yaw_link"/>
    <!-- Place yaw joint on top of base -->
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="3.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- pitch joint: yaw_link -> pitch_link (rotate around Y) -->
  <joint name="pitch_joint" type="revolute">
    <parent link="yaw_link"/>
    <child link="pitch_link"/>
    <!-- Place pitch joint slightly forward and above -->
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- +/- 60 degrees -->
    <limit lower="-1.0472" upper="1.0472" effort="30" velocity="3.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- fixed joint to define gun tip at barrel end -->
  <joint name="gun_tip_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="gun_tip"/>
    <origin xyz="0.09 0.0 0.0" rpy="0 0 0"/>
  </joint>

</robot>
